---
import VideoFrame from './VideoFrame.astro';
import { anillos } from '~/data/circulo';
---

<section id="que">
  <div class="wrap">
    {/* data-focus: el nav centra este bloque en pantalla al clickear "¿Qué carajo?" */}
    <div class="video-slot reveal" data-focus>
      <VideoFrame label="Mirá el video · 90 seg" todo="[ video a producir ]">
        <p class="kicker v-kicker">La pregunta que todos se hacen</p>
        <h2 class="v-title">
          ¿Qué carajo es<br /><span class="y">Gran Berta Films?</span>
        </h2>
      </VideoFrame>
    </div>

    <div class="circulo-zone reveal">
      <div class="circ-wrap">
        <div class="circ-spin" aria-hidden="true"></div>
        {
          anillos.map((a) => (
            <button
              type="button"
              class={`ring ring-${a.key}`}
              data-k={a.key}
              aria-controls={`panel-${a.key}`}
              aria-expanded="false"
            >
              <span class="ring-label">{a.label}</span>
              <span class="visually-hidden">— {a.kicker}</span>
            </button>
          ))
        }
        <div class="circ-core" aria-hidden="true">
          <span data-core-hint>Tocá<br />los anillos</span>
        </div>
      </div>

      <div class="circ-panel">
        <p class="circ-hint" data-start-hint>
          ← Empezá por el centro. Siempre por el centro.
        </p>
        {
          anillos.map((a) => (
            <div class="p-item" id={`panel-${a.key}`} data-panel={a.key}>
              <p class="p-kicker">{a.kicker}</p>
              <p class="p-frase" set:html={a.frase} />
              <p class="p-body">{a.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .video-slot {
    margin-bottom: 80px;
    /* Al centrarlo tiene que entrar entero: como el recuadro es 16:9 y lo
       manda el ancho, le ponemos techo al ancho para acotarle el alto. */
    max-width: min(100%, calc(76vh * 16 / 9));
    margin-inline: auto;
  }

  /* --- título dentro del recuadro del video ----------------------------- */

  .v-kicker {
    margin-bottom: 10px;
  }


  .circulo-zone {
    display: grid;
    grid-template-columns: minmax(300px, 460px) 1fr;
    gap: 60px;
    align-items: center;
  }

  /* --- el círculo ------------------------------------------------------- */

  .circ-wrap {
    position: relative;
    aspect-ratio: 1;
    max-width: 460px;
    margin: 0 auto;
    width: 100%;
  }

  .ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid #2a2a2a;
    background: transparent;
    font: inherit;
    color: inherit;
    padding: 0;
    cursor: pointer;
    transition:
      border-color 0.4s,
      box-shadow 0.4s;
    display: flex;
    justify-content: center;
  }

  .ring:hover {
    border-color: var(--gold);
  }

  .ring[aria-expanded='true'] {
    border-color: var(--yellow);
    box-shadow:
      0 0 40px rgba(255, 232, 0, 0.12),
      inset 0 0 40px rgba(255, 232, 0, 0.05);
  }

  .ring-que {
    inset: 0;
  }
  .ring-como {
    inset: 16.5%;
  }
  .ring-why {
    inset: 33%;
  }

  .ring-label {
    position: absolute;
    top: 0;
    transform: translateY(-50%);
    background: var(--black);
    padding: 0 12px;
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--dim);
    transition: color 0.4s;
    pointer-events: none;
  }

  .ring:hover .ring-label {
    color: var(--gold);
  }

  .ring[aria-expanded='true'] .ring-label {
    color: var(--yellow);
  }

  .circ-core {
    position: absolute;
    inset: 41%;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
  }

  .circ-core span {
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mute-2);
    animation: corepulse 3s infinite;
  }

  .circ-core span.done {
    color: var(--yellow);
  }

  @keyframes corepulse {
    0%,
    100% {
      opacity: 0.4;
    }
    50% {
      opacity: 1;
    }
  }

  .circ-spin {
    position: absolute;
    inset: -4%;
    border-radius: 50%;
    border: 1px dashed #1a1a1a;
    animation: spin 60s linear infinite;
    pointer-events: none;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* --- el panel --------------------------------------------------------- */

  .circ-panel {
    min-height: 340px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .circ-hint {
    color: var(--mute-2);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  /* Estado base = los tres textos visibles. Van en el HTML, así que se
     indexan y se leen aunque el JS no cargue. El script agrega .js al panel
     y recién ahí pasa a comportarse como acordeón animado. */
  .p-item + .p-item {
    margin-top: 40px;
  }

  .p-item[hidden] {
    display: none;
  }

  .p-kicker {
    color: var(--gold);
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .p-frase {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.6rem);
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: 20px;
  }

  .p-frase :global(em) {
    font-style: normal;
    color: var(--yellow);
  }

  .p-body {
    color: var(--dim);
    max-width: 480px;
  }

  .circ-panel.js .p-item + .p-item {
    margin-top: 0;
  }

  .circ-panel.js .p-kicker {
    opacity: 0;
    transition: opacity 0.5s;
  }

  .circ-panel.js .p-frase {
    opacity: 0;
    transform: translateY(14px);
    transition: all 0.5s;
  }

  .circ-panel.js .p-body {
    opacity: 0;
    transform: translateY(14px);
    transition: all 0.5s 0.1s;
  }

  .circ-panel.js .p-item.show .p-kicker,
  .circ-panel.js .p-item.show .p-frase,
  .circ-panel.js .p-item.show .p-body {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 860px) {
    .circulo-zone {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const zona = document.querySelector<HTMLElement>('.circulo-zone');
  const panel = zona?.querySelector<HTMLElement>('.circ-panel');

  if (zona && panel) {
    const rings = zona.querySelectorAll<HTMLButtonElement>('.ring');
    const items = zona.querySelectorAll<HTMLElement>('.p-item');
    const startHint = zona.querySelector<HTMLElement>('[data-start-hint]');
    const coreHint = zona.querySelector<HTMLElement>('[data-core-hint]');
    const vistos = new Set<string>();

    // A partir de acá el panel es interactivo: arranca vacío, con la pista.
    panel.classList.add('js');
    items.forEach((it) => (it.hidden = true));

    const abrir = (k: string) => {
      rings.forEach((r) => r.setAttribute('aria-expanded', String(r.dataset.k === k)));
      items.forEach((it) => {
        it.classList.remove('show');
        if (it.dataset.panel !== k) it.hidden = true;
      });

      if (startHint) startHint.hidden = true;

      const target = panel.querySelector<HTMLElement>(`.p-item[data-panel="${k}"]`);
      if (!target) return;

      // Pequeño delay para que se note el cambio al saltar de un anillo a otro.
      window.setTimeout(() => {
        target.hidden = false;
        void target.offsetWidth; // fuerza reflow antes de animar
        target.classList.add('show');
      }, 180);

      vistos.add(k);
      if (vistos.size === rings.length && coreHint) {
        coreHint.innerHTML = 'Eso<br>somos.';
        coreHint.classList.add('done');
      }
    };

    rings.forEach((ring) => {
      ring.addEventListener('click', (ev) => {
        ev.stopPropagation();
        if (ring.dataset.k) abrir(ring.dataset.k);
      });
    });
  }
</script>
