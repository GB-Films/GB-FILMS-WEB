---
import VideoFrame from './VideoFrame.astro';
---

<section id="que">
  <div class="wrap">
    <div class="video-slot reveal" data-focus>
      <VideoFrame label="Reel GB Films · 2026" videoUrl="https://www.youtube.com/embed/3XmSSSB9Cwg" posterUrl={`${import.meta.env.BASE_URL}reel/gb-films-reel-2026.webp`}>
        <p class="kicker v-kicker">La pregunta que todos se hacen</p>
        <h2 class="v-title">
          ¿Qué carajo es<br /><span class="y">Gran Berta Films?</span>
        </h2>
      </VideoFrame>
    </div>
  </div>
</section>

<style>
  .video-slot {
    max-width: min(100%, calc(76vh * 16 / 9));
    margin-inline: auto;
  }

  .v-kicker {
    margin-bottom: 10px;
  }
</style>
