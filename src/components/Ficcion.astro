---
import { Image } from 'astro:assets';
import { ips } from '~/data/trabajos';

// Dos copias permiten que la franja avance sin un corte visible.
const copias = [false, true];
const base = import.meta.env.BASE_URL;
---

<section id="ficcion">
  <div data-focus>
    <div class="wrap">
      <h2 class="sec-title reveal">Nuestras <span class="y">historias.</span></h2>
    </div>

    <div class="marquee carrusel reveal" data-franja-ficcion>
      <ul class="pista" aria-label="Proyectos de ficción">
        {
          copias.map((clon) =>
            ips.map((ip) => (
              <li class="ip-item" aria-hidden={clon ? 'true' : undefined}>
                <a class="ip" href={`${base}ficcion/${ip.id}/`} tabindex={clon ? -1 : undefined}>
                  {ip.poster && (
                    <Image
                      class:list={['poster', { 'poster-contain': ip.posterContain }]}
                      src={ip.poster}
                      alt=""
                      width={660}
                      widths={[330, 660]}
                      sizes="(max-width: 700px) 255px, 330px"
                      loading="lazy"
                    />
                  )}
                  <span class="ip-titulo">{ip.titulo}</span>
                  <span class="tipo">{ip.tipo}</span>
                  <span class="visually-hidden">Ver ficha del proyecto</span>
                </a>
              </li>
            )),
          )
        }
      </ul>
    </div>
  </div>
</section>

<style>
  #ficcion { padding-top: 42px; }
  #ficcion [data-focus] { scroll-margin-top: 36px; }

  .sec-title {
    font-size: clamp(2rem, 5vw, 3.6rem);
    margin-bottom: 42px;
  }

  .carrusel {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
  }

  .carrusel::-webkit-scrollbar { display: none; }
  .carrusel.auto { overflow: hidden; touch-action: pan-y; }
  .carrusel .ip { cursor: grab; user-select: none; }
  .carrusel.arrastrando .ip { cursor: grabbing; }
  .carrusel img { -webkit-user-drag: none; }

  .pista {
    list-style: none;
    display: flex;
    gap: 16px;
    width: max-content;
    will-change: transform;
    padding-block: 12px;
  }

  .ip-item { flex: 0 0 clamp(255px, 26vw, 330px); }

  .ip {
    width: 100%;
    aspect-ratio: 9 / 16;
    background: var(--surface);
    border: 1px solid var(--line-2);
    color: inherit;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 20px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
  }

  .ip:hover,
  .ip:focus-visible {
    border-color: var(--accent);
    box-shadow: 0 0 28px color-mix(in srgb, var(--accent) 18%, transparent);
    transform: translateY(-4px);
  }

  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    transition: transform 0.4s ease;
  }

  .poster-contain { object-fit: contain; }
  .ip:hover .poster { transform: scale(1.05); }

  .ip:has(.poster)::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.92) 12%, rgba(0, 0, 0, 0.25) 55%, transparent);
  }

  .ip-titulo,
  .tipo { position: relative; z-index: 2; }

  .ip-titulo {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    line-height: 1.05;
  }

  .tipo {
    color: var(--dim);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-top: 6px;
  }
</style>

<script>
  import { montarFranja } from '~/scripts/franja';

  const carrusel = document.querySelector<HTMLElement>('[data-franja-ficcion]');
  const pista = carrusel?.querySelector<HTMLElement>('.pista');
  if (carrusel && pista) {
    const tienePuntero = window.matchMedia('(hover: hover)');
    montarFranja(carrusel, pista, {
      frenada: () => tienePuntero.matches && Boolean(carrusel.querySelector('.ip:hover')),
      arrastrarMouse: true,
    });
  }
</script>
