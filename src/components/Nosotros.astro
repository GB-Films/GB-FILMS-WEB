---
import { equipo, manifiesto } from '~/data/equipo';

// Duplicado para que el loop de la franja no tenga costura; la copia va
// aria-hidden y sin tab para que no se lea dos veces.
const copias = [false, true];
---

<section id="nosotros" aria-label="Nosotros">
  {/* El foco alinea el manifiesto y los retratos al navegar. */}
  <div data-focus>
  <div class="wrap manifiesto-wrap">
    <div class="intro reveal">
      <div class="manifiesto-layout" data-manifiesto>
        <div class="manifiesto-copy">
          {manifiesto.estrofas.slice(0, 2).map((estrofa) => (
            <p>{estrofa.map((frase) => frase.join(' ')).join(' ')}</p>
          ))}
        </div>

        <div class="manifiesto-cierre" aria-label="Son ellos, somos nosotros, sos vos">
          {manifiesto.estrofas[2].map((frase, i) => (
            <p class:list={['cierre-line', { 'cierre-accent': i === 2 }]}>{frase.join(' ')}</p>
          ))}
        </div>
      </div>
    </div>

  </div>

  <div class="marquee team-franja reveal" data-franja-equipo>
      <ul class="pista">
      {
        copias.map((clon) =>
        equipo.map((m) => (
          <li class="card-item" aria-hidden={clon ? 'true' : undefined}>
          <article class="card">
            <button type="button" class="mas" aria-expanded="false" tabindex={clon ? -1 : undefined}>
              <span aria-hidden="true">+</span>
              <span class="visually-hidden">Ver más sobre {m.nombre}</span>
            </button>
            <div class="foto">
              {m.foto ? (
                <img src={`${import.meta.env.BASE_URL}${m.foto}`} alt={m.nombre} width="720" height="720" loading="lazy" decoding="async" />
              ) : (
                <span>[ Foto {m.nombre.split(' ')[0]} ]</span>
              )}
            </div>
            <div class="base">
              <h3>{m.nombre}</h3>
              <span class="rol">{m.rol}</span>
            </div>
            <div class="velo">
              <p class="linea">{m.linea}</p>
              <p>{m.bio}</p>
            </div>
          </article>
          </li>
        )),
        )
      }
    </ul>
  </div>

  </div>
</section>

<style>
  #nosotros {
    padding-top: 60px;
  }

  .manifiesto-wrap {
    max-width: none;
    padding-inline: clamp(24px, 5vw, 96px);
  }

  .intro {
    margin-bottom: clamp(36px, 4vw, 52px);
  }

  .manifiesto-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
    gap: clamp(36px, 7vw, 120px);
    align-items: stretch;
  }

  .manifiesto-copy {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-left: 3px solid var(--accent);
    padding: 8px 0 8px clamp(18px, 2.2vw, 32px);
    color: var(--silver);
    font-size: clamp(1rem, 1.35vw, 1.3rem);
    line-height: 1.65;
  }

  .manifiesto-copy p + p {
    margin-top: 0;
  }

  .manifiesto-cierre {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .cierre-line {
    font-size: clamp(1.8rem, 3.5vw, 3.7rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .cierre-accent {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 5.3rem);
    font-weight: 400;
    letter-spacing: 0.005em;
    text-transform: uppercase;
  }

  @media (max-width: 860px) {
    .manifiesto-layout {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .manifiesto-copy,
    .manifiesto-cierre {
      justify-content: initial;
      gap: 16px;
    }

    .manifiesto-copy p + p {
      margin-top: 0;
    }

    .manifiesto-cierre {
      padding-left: clamp(20px, 5vw, 36px);
    }

    .cierre-line {
      font-size: clamp(1.65rem, 6vw, 2.8rem);
    }

    .cierre-accent {
      font-size: clamp(2.5rem, 9vw, 4.2rem);
    }
  }

  /* Misma franja que la de marcas: se recorta sólo cuando el script toma el
     control (clase .auto); sin JS queda arrastrable a mano. */
  .team-franja {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
  }

  .team-franja::-webkit-scrollbar {
    display: none;
  }

  .team-franja.auto {
    overflow: hidden;
    touch-action: pan-y;
    user-select: none;
    cursor: grab;
  }

  .team-franja.arrastrando {
    cursor: grabbing;
  }

  .pista {
    list-style: none;
    display: flex;
    gap: 20px;
    width: max-content;
    will-change: transform;
    /* aire para que el recorte no se coma el borde de las tarjetas */
    padding-block: 2px;
  }

  .card-item {
    flex: 0 0 clamp(225px, 19vw, 270px);
  }

  .card {
    border: 1px solid var(--line-2);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 405px;
    cursor: pointer;
    overflow: hidden;
    background: var(--surface-2);
  }

  .card:hover {
    border-color: var(--light);
  }

  .foto {
    height: 280px;
    flex: 0 0 280px;
    background: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #333;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: filter 0.4s;
  }

  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .base {
    flex: 1;
    padding: 18px 20px;
  }

  .card h3 {
    font-size: 1.15rem;
    color: var(--ink);
  }

  .rol {
    color: var(--dim);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 4px;
    display: block;
  }

  .mas {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    background: none;
    border: 0;
    padding: 0;
    line-height: 1;
    color: #333;
    font-size: 1.1rem;
    cursor: pointer;
    transition: all 0.3s;
  }

  .velo {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    padding: 26px 22px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.45s;
  }

  .velo .linea {
    font-family: var(--font-display);
    color: var(--light);
    font-size: 1.25rem;
    text-transform: uppercase;
    line-height: 1.15;
    margin-bottom: 14px;
  }

  .velo p {
    color: var(--dim);
    font-size: 0.85rem;
  }

  .card:hover .velo,
  .card.open .velo {
    opacity: 1;
  }

  .card:hover .mas,
  .card.open .mas {
    color: var(--light);
    transform: rotate(45deg);
  }

</style>

<script>
  import { montarFranja } from '~/scripts/franja';

  // Franja del equipo: mismo movimiento que la de marcas. Se frena cuando hay
  // una tarjeta abierta, para poder leer la bio sin que se escape.
  const franjaEquipo = document.querySelector<HTMLElement>('[data-franja-equipo]');
  const pistaEquipo = franjaEquipo?.querySelector<HTMLElement>('.pista');
  if (franjaEquipo && pistaEquipo) {
    montarFranja(franjaEquipo, pistaEquipo, {
      frenada: () => !!franjaEquipo.querySelector('.card.open'),
      arrastrarMouse: true,
    });
  }

  // El click en cualquier parte de la tarjeta abre el velo (mobile). El botón
  // "+" no tiene handler propio a propósito: su click burbujea hasta acá, así
  // Enter/Espacio desde el teclado hacen exactamente lo mismo que el tap.
  document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
    card.addEventListener('click', () => {
      const abierta = card.classList.toggle('open');
      card.querySelector('.mas')?.setAttribute('aria-expanded', String(abierta));
    });
  });
</script>
