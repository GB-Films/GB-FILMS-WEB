---
import { hermanas } from '~/data/trabajos';
---

<section id="universo">
  <div class="wrap">
    <p class="kicker reveal">El universo</p>
    <h2 class="sec-title reveal">GB Films no está <span class="y">sola</span></h2>

    <div class="hermanas reveal">
      {
        hermanas.map((h) => (
          <a class="hermana" href={h.url} target="_blank" rel="noopener noreferrer">
            <div class="hermana-logo">
              <img src={`${import.meta.env.BASE_URL}${h.logo}`} alt={`Logo de ${h.nombre}`} loading="lazy" decoding="async" />
            </div>
            <div class="hermana-info">
              <span class="rol">{h.rol}</span>
              <h3>{h.nombre}</h3>
              <p>{h.texto}</p>
              <span class="visitar">Conocé {h.nombre} ↗</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  #universo .wrap {
    max-width: 1500px;
  }

  .hermanas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .hermana {
    border: 1px solid var(--line-2);
    display: flex;
    align-items: center;
    gap: clamp(16px, 2vw, 26px);
    min-width: 0;
    padding: clamp(18px, 2.2vw, 28px);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .hermana:hover,
  .hermana:focus-visible {
    border-color: var(--accent);
  }

  .hermana-logo {
    width: clamp(88px, 8vw, 116px);
    aspect-ratio: 1;
    flex: 0 0 clamp(88px, 8vw, 116px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hermana-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hermana-info {
    min-width: 0;
    flex: 1;
  }

  .hermana h3 {
    color: var(--ink);
    font-size: 1.5rem;
    margin-bottom: 10px;
  }

  .hermana p {
    color: var(--dim);
    font-size: 0.92rem;
  }

  .hermana .rol {
    color: var(--silver);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 12px;
  }

  .visitar {
    display: inline-flex;
    margin-top: 14px;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hermana:hover .visitar,
  .hermana:focus-visible .visitar {
    color: var(--ink);
  }

  @media (max-width: 1100px) {
    .hermanas {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 430px) {
    .hermana {
      gap: 14px;
      padding: 16px;
    }

    .hermana-logo {
      width: 66px;
      flex-basis: 66px;
    }
  }
</style>
