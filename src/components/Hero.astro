---
import { site } from '~/data/site';
const reelBackground = `${import.meta.env.BASE_URL}reel/gb-films-fondo-v06.mp4`;
const reelPoster = `${import.meta.env.BASE_URL}reel/gb-films-fondo-v06.webp`;
---

<header id="top">
  <div class="hero-media" aria-hidden="true">
    <video src={reelBackground} poster={reelPoster} muted loop playsinline preload="metadata"></video>
  </div>
  <div class="wrap">
    <p class="hero-kicker">{site.name} · {site.city}</p>
    <h1 class="hero-title" aria-label="Hacemos cultura.">Hacemos<br /><span class="hero-word" data-hero-word aria-hidden="true">Cultura.</span></h1>
    <p class="hero-sub">
      Publicidades, contenido digital, videoclips y ficción.<br />
      <strong>La cultura no se observa, se hace.</strong>
    </p>
  </div>
  <span class="scroll-hint" aria-hidden="true">Scrolleá ↓</span>
</header>

<style>
  header {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    background: #111;
  }

  .hero-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.015);
    filter: grayscale(1) blur(1px) brightness(0.82);
  }

  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.62), rgba(0, 0, 0, 0.22) 65%, rgba(0, 0, 0, 0.42));
  }

  .wrap {
    position: relative;
    z-index: 1;
  }

  .hero-kicker {
    color: var(--silver);
    font-size: 0.8rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .hero-title {
    font-size: clamp(3.6rem, 12vw, 9.5rem);
    line-height: 0.92;
    color: var(--silver);
    position: relative;
  }

  .hero-word {
    color: var(--accent);
    white-space: nowrap;
  }

  :global(html.js) .hero-word:not(.escribiendo) { visibility: hidden; }

  .hero-sub {
    margin-top: 26px;
    max-width: 520px;
    color: var(--dim);
    font-size: 1.05rem;
  }

  .hero-sub strong {
    color: var(--ink);
  }

  .scroll-hint {
    position: absolute;
    bottom: 28px;
    left: var(--gutter);
    color: var(--dim);
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    animation: blink 2.4s infinite;
    z-index: 1;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }

</style>

<script>
  const hero = document.querySelector<HTMLElement>('header#top');
  const video = hero?.querySelector<HTMLVideoElement>('.hero-media video');
  const palabra = hero?.querySelector<HTMLElement>('[data-hero-word]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (palabra) {
    palabra.classList.add('escribiendo');
    if (!reducedMotion.matches) {
      const pasos = [
        ['C', 180], ['CU', 180], ['CUL', 180], ['CULO', 180], ['CULOS', 560],
        ['CULO', 180], ['CUL', 260], ['CULT', 160], ['CULTU', 160],
        ['CULTUR', 160], ['CULTURA', 280], ['CULTURA.', 0],
      ] as const;
      palabra.textContent = '';
      let paso = 0;
      let temporizador: number;
      const escribir = () => {
        if (reducedMotion.matches || paso >= pasos.length) {
          palabra.textContent = 'Cultura.';
          return;
        }
        const [texto, espera] = pasos[paso++];
        palabra.textContent = texto;
        temporizador = window.setTimeout(escribir, espera);
      };
      temporizador = window.setTimeout(escribir, 280);
      reducedMotion.addEventListener('change', () => {
        if (reducedMotion.matches) {
          window.clearTimeout(temporizador);
          palabra.textContent = 'Cultura.';
        }
      });
    }
  }

  if (hero && video) {
    const observer = new IntersectionObserver(([entry]) => {
      const shouldPlay = entry.isIntersecting && !reducedMotion.matches;
      if (shouldPlay) video.play().catch(() => {});
      else video.pause();
    }, { threshold: 0.05 });
    observer.observe(hero);
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) video.pause();
      else if (hero.getBoundingClientRect().bottom > 0) video.play().catch(() => {});
    });
  }
</script>
