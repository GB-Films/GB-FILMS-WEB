---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import { ips, type Ip } from '~/data/trabajos';

interface Props { ip: Ip; index: number }

export function getStaticPaths() {
  return ips.map((ip, index) => ({ params: { id: ip.id }, props: { ip, index } }));
}

const { ip, index } = Astro.props;
const base = import.meta.env.BASE_URL;
const anterior = ips[(index - 1 + ips.length) % ips.length];
const siguiente = ips[(index + 1) % ips.length];
const datos = [
  { label: 'Formato', value: ip.tipo },
  ...(ip.generos?.length ? [{ label: 'Género', value: ip.generos.join(' · ') }] : []),
  ...(ip.anio ? [{ label: 'Año', value: ip.anio }] : []),
  ...(ip.duracion ? [{ label: 'Duración', value: ip.duracion }] : []),
  ...(ip.episodios ? [{ label: 'Episodios', value: String(ip.episodios) }] : []),
  ...(ip.direccion ? [{ label: 'Dirección', value: ip.direccion }] : []),
  ...(ip.guion ? [{ label: 'Guion', value: ip.guion }] : []),
  ...(ip.elenco?.length ? [{ label: 'Elenco', value: ip.elenco.join(' · ') }] : []),
];
---

<Base title={`${ip.titulo} | Gran Berta Films`} description={ip.sinopsis ?? `${ip.titulo}, un proyecto de ficción de Gran Berta Films.`}>
  <Nav homeLinks />
  <main id="main" class="proyecto">
    <div class="wrap">
      <a class="volver" href={`${base}#ficcion`}>← Volver a nuestras historias</a>

      <header class="cabecera">
        <div>
          <p class="kicker">Gran Berta Films <span aria-hidden="true">/</span> {ip.tipo}</p>
          <h1>{ip.titulo}</h1>
          {ip.gancho && <p class="gancho">{ip.gancho}</p>}
        </div>
        <span class="numero" aria-hidden="true">{String(index + 1).padStart(2, '0')} / {String(ips.length).padStart(2, '0')}</span>
      </header>

      <div class="contenido">
        <div class="afiche">
          {ip.poster && (
            <Image
              src={ip.poster}
              alt={`Póster de ${ip.titulo}`}
              width={940}
              widths={[360, 720, 940]}
              sizes="(max-width: 800px) 90vw, 470px"
              loading="eager"
            />
          )}
        </div>

        <div class="detalle">
          <section class="historia" aria-labelledby="historia-titulo">
            <p class="etiqueta">La historia</p>
            <h2 id="historia-titulo">¿De qué trata?</h2>
            {ip.sinopsis ? (
              <p>{ip.sinopsis}</p>
            ) : (
              <p class="pendiente">La sinopsis oficial de este proyecto está en preparación.</p>
            )}
            {ip.link && (
              <a class="ver" href={ip.link.url} target="_blank" rel="noopener noreferrer">
                {ip.link.label} ↗
              </a>
            )}
          </section>

          <section class="datos" aria-label="Datos del proyecto">
            <p class="etiqueta">Ficha del proyecto</p>
            <dl>
              {datos.map((dato) => (
                <div>
                  <dt>{dato.label}</dt>
                  <dd>{dato.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        </div>
      </div>

      <nav class="otros" aria-label="Otros proyectos">
        <a href={`${base}ficcion/${anterior.id}/`}>
          <span>← Proyecto anterior</span>
          <strong>{anterior.titulo}</strong>
        </a>
        <a href={`${base}ficcion/${siguiente.id}/`}>
          <span>Proyecto siguiente →</span>
          <strong>{siguiente.titulo}</strong>
        </a>
      </nav>
    </div>
  </main>
  <Footer homeLinks />
</Base>

<style>
  .proyecto { padding-top: calc(var(--nav-h) + 50px); }
  .proyecto .wrap { max-width: 1280px; }

  .volver {
    display: inline-block;
    color: var(--silver);
    font-size: 0.76rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    margin-bottom: clamp(34px, 5vw, 70px);
  }
  .volver:hover { color: var(--accent); }

  .cabecera {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-bottom: clamp(30px, 4vw, 52px);
  }
  .cabecera .kicker { margin-bottom: 12px; }
  .cabecera .kicker span { padding-inline: 9px; color: var(--accent); }
  h1 {
    font-size: clamp(3.5rem, 9.5vw, 8.5rem);
    line-height: 0.98;
    max-width: 1000px;
  }
  .gancho {
    margin-top: 22px;
    color: var(--silver);
    font-size: clamp(1rem, 1.65vw, 1.3rem);
    max-width: 620px;
  }
  .numero {
    white-space: nowrap;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 1;
  }

  .contenido {
    display: grid;
    grid-template-columns: minmax(300px, 0.88fr) minmax(0, 1.12fr);
    gap: clamp(40px, 6vw, 100px);
    align-items: start;
  }
  .afiche {
    aspect-ratio: 2 / 3;
    border: 1px solid var(--line-2);
    background: var(--surface);
    overflow: hidden;
  }
  .afiche img { width: 100%; height: 100%; object-fit: contain; }

  .detalle { padding-top: clamp(0px, 2vw, 26px); }
  .etiqueta {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--accent);
    margin-bottom: 18px;
  }
  .historia h2 {
    font-size: clamp(2rem, 4vw, 3.8rem);
    line-height: 1.05;
    margin-bottom: 25px;
  }
  .historia > p:not(.etiqueta) {
    color: var(--silver);
    font-size: clamp(1rem, 1.6vw, 1.22rem);
    line-height: 1.85;
    max-width: 630px;
  }
  .historia .pendiente { color: var(--dim); }
  .ver {
    display: inline-block;
    background: var(--accent);
    color: #000;
    padding: 11px 20px;
    margin-top: 28px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .ver:hover { background: var(--light); }

  .datos {
    margin-top: clamp(45px, 5vw, 72px);
    border-top: 1px solid var(--line-2);
    padding-top: 26px;
  }
  .datos dl > div {
    display: grid;
    grid-template-columns: minmax(105px, 27%) 1fr;
    gap: 20px;
    border-bottom: 1px solid var(--line-2);
    padding: 15px 0;
  }
  .datos dt {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--dim);
  }
  .datos dd { color: var(--light); }

  .otros {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: clamp(75px, 9vw, 130px);
    border-top: 1px solid var(--line-2);
    padding-top: 28px;
  }
  .otros a { display: flex; flex-direction: column; gap: 4px; }
  .otros a:last-child { text-align: right; }
  .otros span {
    color: var(--dim);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }
  .otros strong {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 400;
    text-transform: uppercase;
  }
  .otros a:hover strong { color: var(--accent); }

  @media (max-width: 800px) {
    .contenido { grid-template-columns: 1fr; }
    .afiche { width: min(100%, 520px); }
    .detalle { padding-top: 0; }
    .cabecera { align-items: flex-start; }
  }
  @media (max-width: 540px) {
    .cabecera { display: block; }
    .numero { display: none; }
    .datos dl > div { grid-template-columns: 1fr; gap: 4px; }
    .otros { gap: 12px; }
  }
</style>
