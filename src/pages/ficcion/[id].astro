---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import { ips, type Ip } from '~/data/trabajos';

interface Props { ip: Ip; index: number }

export function getStaticPaths() {
  return ips.map((ip, index) => ({ params: { id: ip.id }, props: { ip, index } }));
}

const { ip, index } = Astro.props;
const base = import.meta.env.BASE_URL;
const anterior = ips[(index - 1 + ips.length) % ips.length];
const siguiente = ips[(index + 1) % ips.length];
const datosBasicos = [
  { label: 'Formato', value: ip.tipo },
  ...(ip.generos?.length ? [{ label: 'Género', value: ip.generos.join(' · ') }] : []),
  ...(ip.anio ? [{ label: 'Año', value: ip.anio }] : []),
  ...(ip.duracion ? [{ label: 'Duración', value: ip.duracion }] : []),
  ...(ip.episodios ? [{ label: 'Episodios', value: String(ip.episodios) }] : []),
];
const creditos = [
  ...(ip.direccion ? [{ label: 'Dirección', value: ip.direccion }] : []),
  ...(ip.guion ? [{ label: 'Guion', value: ip.guion }] : []),
  ...(ip.elenco?.length ? [{ label: 'Elenco', value: ip.elenco.join(' · ') }] : []),
];
---

<Base title={`${ip.titulo} | Gran Berta Films`} description={ip.sinopsis ?? `${ip.titulo}, un proyecto de ficción de Gran Berta Films.`}>
  <Nav homeLinks />
  <main id="main" class="proyecto">
    <div class="wrap">
      <a class="volver" href={`${base}#ficcion`}>← Volver</a>

      <div class="contenido">
        <div class="afiche">
          {ip.poster && (
            <Image
              src={ip.poster}
              alt={`Póster de ${ip.titulo}`}
              width={940}
              widths={[360, 720, 940]}
              sizes="(max-width: 800px) 90vw, 430px"
              loading="eager"
            />
          )}
        </div>

        <div class="detalle">
          <header class="cabecera">
            <p class="kicker">Gran Berta Films <span aria-hidden="true">/</span> {ip.tipo}</p>
            <h1>{ip.titulo}</h1>
            {ip.gancho && <p class="gancho">{ip.gancho}</p>}
            <span class="numero" aria-hidden="true">{String(index + 1).padStart(2, '0')} / {String(ips.length).padStart(2, '0')}</span>
          </header>

          <section class="historia" aria-labelledby="historia-titulo">
            <h2 class="etiqueta" id="historia-titulo">La historia</h2>
            {ip.sinopsis ? (
              <p>{ip.sinopsis}</p>
            ) : (
              <p class="pendiente">La sinopsis oficial de este proyecto está en preparación.</p>
            )}
            {ip.link && (
              <a class="ver" href={ip.link.url} target="_blank" rel="noopener noreferrer">
                {ip.link.label} ↗
              </a>
            )}
          </section>

          <section class="datos" aria-label="Datos básicos del proyecto">
            <h2 class="etiqueta">Datos básicos</h2>
            <dl>
              {datosBasicos.map((dato) => (
                <div>
                  <dt>{dato.label}</dt>
                  <dd>{dato.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        </div>
      </div>

      {creditos.length > 0 && (
        <section class="creditos" aria-label="Créditos del proyecto">
          <h2 class="etiqueta">Créditos</h2>
          <dl>
            {creditos.map((dato) => (
              <div>
                <dt>{dato.label}</dt>
                <dd>{dato.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      <nav class="otros" aria-label="Otros proyectos">
        <a href={`${base}ficcion/${anterior.id}/`}>
          <span>← Proyecto anterior</span>
          <strong>{anterior.titulo}</strong>
        </a>
        <a href={`${base}ficcion/${siguiente.id}/`}>
          <span>Proyecto siguiente →</span>
          <strong>{siguiente.titulo}</strong>
        </a>
      </nav>
    </div>
  </main>
  <Footer homeLinks />
</Base>

<style>
  .proyecto { padding-top: calc(var(--nav-h) + 14px); padding-bottom: 72px; }
  .proyecto .wrap { max-width: 1280px; }

  .volver {
    position: sticky;
    top: calc(var(--nav-h) + 10px);
    z-index: 40;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 7px 12px;
    color: var(--light);
    background: rgba(0, 0, 0, 0.94);
    border: 1px solid var(--line-2);
    font-size: 0.76rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }
  .volver:hover { color: var(--accent); border-color: var(--accent); }

  .cabecera {
    position: relative;
    padding-right: 78px;
    margin-bottom: clamp(20px, 2.8vh, 30px);
  }
  .cabecera .kicker { margin-bottom: 10px; }
  .cabecera .kicker span { padding-inline: 9px; color: var(--accent); }
  h1 {
    font-size: clamp(2.6rem, 5vw, 5rem);
    line-height: 1.03;
    max-width: 720px;
    text-wrap: balance;
  }
  .gancho {
    margin-top: 12px;
    color: var(--silver);
    font-size: clamp(0.95rem, 1.4vw, 1.15rem);
    max-width: 620px;
  }
  .numero {
    position: absolute;
    top: 0;
    right: 0;
    white-space: nowrap;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.2vw, 2rem);
    line-height: 1;
  }

  .contenido {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
  }
  .afiche {
    display: flex;
    justify-content: center;
    min-width: 0;
  }
  .afiche img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: min(720px, calc(100svh - var(--nav-h) - 108px));
    object-fit: contain;
    border: 1px solid var(--line-2);
  }

  .detalle { min-width: 0; padding-top: 2px; }
  .historia, .datos, .creditos { padding: 0; border: 0; }
  .etiqueta {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .historia > p:not(.etiqueta) {
    color: var(--silver);
    font-size: clamp(0.94rem, 1.2vw, 1.08rem);
    line-height: 1.65;
    max-width: 630px;
  }
  .historia .pendiente { color: var(--dim); }
  .ver {
    display: inline-block;
    background: var(--accent);
    color: #000;
    padding: 11px 20px;
    margin-top: 18px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .ver:hover { background: var(--light); }

  .datos {
    margin-top: clamp(22px, 3.5vh, 36px);
    border-top: 1px solid var(--line-2);
    padding-top: 16px;
  }
  .datos dl > div, .creditos dl > div {
    display: grid;
    grid-template-columns: minmax(105px, 27%) 1fr;
    gap: 20px;
    border-bottom: 1px solid var(--line-2);
    padding: 9px 0;
  }
  .datos dt, .creditos dt {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--dim);
  }
  .datos dd, .creditos dd { color: var(--light); }

  .creditos {
    max-width: 680px;
    margin: 48px 0 0 auto;
    border-top: 1px solid var(--line-2);
    padding-top: 20px;
  }

  .otros {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: clamp(48px, 6vw, 76px);
    border-top: 1px solid var(--line-2);
    padding-top: 28px;
  }
  .otros a { display: flex; flex-direction: column; gap: 4px; }
  .otros a:last-child { text-align: right; }
  .otros span {
    color: var(--dim);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }
  .otros strong {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 400;
    text-transform: uppercase;
  }
  .otros a:hover strong { color: var(--accent); }

  @media (max-width: 800px) {
    .contenido { grid-template-columns: 1fr; gap: 24px; }
    .afiche { justify-content: flex-start; }
    .afiche img { max-height: min(58svh, 560px); }
    .cabecera { padding-right: 0; }
    .creditos { margin-left: 0; }
  }
  @media (max-width: 540px) {
    .numero { display: none; }
    .datos dl > div, .creditos dl > div { grid-template-columns: 1fr; gap: 2px; }
    .otros { gap: 12px; }
  }
</style>
